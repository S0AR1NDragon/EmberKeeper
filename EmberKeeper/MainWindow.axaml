<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EmberKeeper.MainWindow"
        Width="1600" Height="1000"
        Background="{DynamicResource AppBg}"
        Title="EmberKeeper — рабочий стол мастера">

  <Window.Styles>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AppInk}" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="14" />
    </Style>

    <Style Selector="Button.topbtn">
      <Setter Property="Background" Value="{DynamicResource AppPanel2}" />
      <Setter Property="Foreground" Value="{DynamicResource AppInk}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppLine}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="11,7" />
      <Setter Property="FontSize" Value="12.5" />
    </Style>
    <Style Selector="Button.gold">
      <Setter Property="Background" Value="{DynamicResource AppAccent}" />
      <Setter Property="Foreground" Value="{DynamicResource AppAccentText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppGold}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="11,7" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
  </Window.Styles>

  <Grid x:Name="Shell" ColumnDefinitions="Auto,*">
    <!-- ================= сайдбар ================= -->
    <Border x:Name="Sidebar" Grid.Column="0" Width="248"
            Background="{DynamicResource AppBg2}"
            BorderBrush="{DynamicResource AppLine}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="14,18">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="2,2,2,14">
          <ContentControl x:Name="BrandIcon" VerticalAlignment="Center" Margin="0,0,4,0" />
          <StackPanel Spacing="0">
            <TextBlock Text="EMBERKEEPER" FontFamily="Georgia" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AppGold}" LetterSpacing="0.16" />
            <TextBlock Text="рабочий стол мастера" FontSize="10" Foreground="{DynamicResource AppMuted}" />
          </StackPanel>
        </StackPanel>

        <StackPanel x:Name="NavHost" Grid.Row="2" Spacing="4" />

        <StackPanel Grid.Row="3" Spacing="4" Margin="0,10,0,0">
          <Border Height="1" Background="{DynamicResource AppLine}" Margin="0,4" />
          <TextBlock Text="Все изменения сохранены" FontSize="10.5" Foreground="{DynamicResource AppMuted}" Margin="4,6,0,0" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ================= основная область ================= -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*">
      <Border Grid.Row="0" Background="{DynamicResource AppBg2}"
              BorderBrush="{DynamicResource AppLine}" BorderThickness="0,0,0,1" Padding="16,10">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button x:Name="MenuBtn" Classes="topbtn" Click="OnToggleSidebar" ToolTip.Tip="Меню разделов" />
            <TextBlock Text="EMBERKEEPER" FontSize="10.5" Foreground="{DynamicResource AppMuted}" LetterSpacing="0.12" VerticalAlignment="Center" Margin="6,0,0,0" />
            <TextBlock Text="/" Foreground="{DynamicResource AppMuted}" VerticalAlignment="Center" />
            <TextBlock x:Name="Crumbs" Text="БИБЛИОТЕКА" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AppInk}" LetterSpacing="0.12" VerticalAlignment="Center" />
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
            <Button x:Name="SearchBtn" Classes="topbtn" Click="OnGlobalSearch" ToolTip.Tip="Глобальный поиск (Ctrl+F)" />
            <Button x:Name="ThemeBtn" Classes="topbtn" Click="OnToggleTheme" ToolTip.Tip="Светлая / тёмная тема" />
            <Button x:Name="ScreenBtn" Classes="topbtn" Click="OnPlayerScreen" ToolTip.Tip="Экран игроков (Ctrl+P)" />
            <Button x:Name="GenBtn" Classes="topbtn" Click="OnGenerators" ToolTip.Tip="Генераторы" />
            <Button Classes="gold" Content="d20 +" Click="OnDice" />
          </StackPanel>
        </Grid>
      </Border>

      <ContentControl x:Name="Host" Grid.Row="1" />
    </Grid>
  </Grid>
</Window>
