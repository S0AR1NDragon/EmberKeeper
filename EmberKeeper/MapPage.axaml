<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EmberKeeper.MapPage">

  <UserControl.Styles>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AppInk}" />
      <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>
    <Style Selector="Button.tool">
      <Setter Property="Background" Value="{DynamicResource C_1c1714}" />
      <Setter Property="Foreground" Value="{DynamicResource C_b7a794}" />
      <Setter Property="BorderBrush" Value="{DynamicResource C_2a211a}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,0,6,6" />
    </Style>
    <Style Selector="Button.tool.on">
      <Setter Property="Background" Value="{DynamicResource C_4a3728}" />
      <Setter Property="Foreground" Value="{DynamicResource C_f0c27b}" />
      <Setter Property="BorderBrush" Value="{DynamicResource C_8c7030}" />
    </Style>
    <Style Selector="Button.goldbtn">
      <Setter Property="Background" Value="{DynamicResource C_cf9245}" />
      <Setter Property="Foreground" Value="{DynamicResource C_241505}" />
      <Setter Property="BorderBrush" Value="{DynamicResource C_e0b072}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Margin" Value="0,0,6,6" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource C_1c1714}" />
      <Setter Property="BorderBrush" Value="{DynamicResource C_2a211a}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="TextBox.field, ComboBox.field">
      <Setter Property="Background" Value="{DynamicResource C_15110e}" />
      <Setter Property="Foreground" Value="{DynamicResource C_efe3d2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource C_352a21}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="FontSize" Value="12.5" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="Background" Value="{DynamicResource C_1c1714}" />
      <Setter Property="Foreground" Value="{DynamicResource C_efe3d2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource C_352a21}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource C_3a2d24}" />
    </Style>
    <Style Selector="TextBlock.sec">
      <Setter Property="FontFamily" Value="Georgia" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource C_f6e7cf}" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="TextBlock.lbl">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Foreground" Value="{DynamicResource C_8d7a66}" />
      <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">
    <!-- панель инструментов -->
    <Border Grid.Row="0" Background="{DynamicResource C_15110e}" BorderBrush="{DynamicResource C_2a211a}" BorderThickness="0,0,0,1" Padding="12,10,12,4">
      <WrapPanel Orientation="Horizontal">
        <TextBlock Text="Локация:" VerticalAlignment="Center" Foreground="{DynamicResource C_9c8b78}" FontSize="12" Margin="0,0,8,0" />
        <ComboBox x:Name="LocCombo" Width="200" Margin="0,0,6,6" SelectionChanged="OnLocationChanged" />
        <Button Classes="tool" Content="Добавить" Click="OnAddLocation" />
        <Button Classes="tool" Content="Удалить" Click="OnDeleteLocation" />
        <Button Classes="tool" Content="Имя" Click="OnRenameLocation" />
        <Border Width="1" Background="{DynamicResource C_2a211a}" Margin="6,2,12,8" />
        <Button x:Name="ToolSelect" Classes="tool on" Content="Выбор" Click="OnTool" Tag="select" ToolTip.Tip="Выбор — V" />
        <Button x:Name="ToolWall" Classes="tool" Content="Стена" Click="OnTool" Tag="wall" ToolTip.Tip="Стена — S" />
        <Button x:Name="ToolFog" Classes="tool" Content="Туман" Click="OnTool" Tag="fog" ToolTip.Tip="Туман — F" />
        <Button x:Name="ToolTemplate" Classes="tool" Content="Шаблон" Click="OnTool" Tag="template" ToolTip.Tip="Шаблон — T" />
        <Button x:Name="ToolProp" Classes="tool" Content="Проп" Click="OnTool" Tag="prop" ToolTip.Tip="Предмет — P" />
          <ComboBox x:Name="CbProp" Width="128" SelectionChanged="OnPropPick" VerticalAlignment="Center" />
        <Button x:Name="ToolRuler" Classes="tool" Content="Линейка" Click="OnTool" Tag="ruler" ToolTip.Tip="Линейка — R" />
        <Border Width="1" Background="{DynamicResource C_2a211a}" Margin="6,2,12,8" />
        <Button Classes="tool" Content="−" Click="OnZoomOut" />
        <Button Classes="tool" Content="+" Click="OnZoomIn" />
        <Button Classes="tool" Content="По размеру" Click="OnFit" />
        <Button Classes="tool" Content="Фон…" Click="OnBackground" />
        <Button Classes="tool" Content="Убрать фон" Click="OnClearBackground" />
        <Button Classes="tool" Content="Игрокам" Click="OnPlayerView" />
      </WrapPanel>
    </Border>

    <Grid Grid.Row="1" x:Name="BodyGrid" ColumnDefinitions="*,320">
      <!-- карта -->
      <Border Grid.Column="0" Margin="12" Classes="card" ClipToBounds="True">
        <Grid>
          <ContentControl x:Name="Host" />
          <TextBlock x:Name="HintBar" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                     Margin="10,0,0,8" FontSize="10.5" Foreground="{DynamicResource C_8d7a66}"
                     Background="{DynamicResource C_e60b0908}" Padding="6,2"
                     Text="тащи токен мышью · Shift+клик — удалить пропс/шаблон · клик по двери — открыть/закрыть · Alt+ЛКМ/СКМ — панорама · колесо — масштаб · Ctrl+Z — отмена · Delete — удалить токен · V/S/F/T/P/R — инструменты" />
        </Grid>
      </Border>

      <!-- правая панель -->
      <Border Grid.Column="1" Margin="0,12,12,12" Classes="card">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="14" Spacing="16">

            <!-- ТОКЕН -->
            <StackPanel>
              <TextBlock Classes="sec" Text="Токен" />
              <TextBox x:Name="EdName" Classes="field" Watermark="Имя токена" TextChanged="OnNameChanged" Margin="0,0,0,8" />

              <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,0,0,8">
                <StackPanel>
                  <TextBlock Classes="lbl" Text="ХИТЫ" />
                  <NumericUpDown x:Name="EdHp" Minimum="-999" Maximum="9999" HorizontalAlignment="Stretch" ValueChanged="OnHpChanged" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Classes="lbl" Text="МАКС. ХИТЫ" />
                  <NumericUpDown x:Name="EdMaxHp" Minimum="1" Maximum="9999" HorizontalAlignment="Stretch" ValueChanged="OnMaxHpChanged" />
                </StackPanel>
              </Grid>

              <StackPanel Margin="0,0,0,8">
                <TextBlock Classes="lbl" Text="РАЗМЕР, КЛЕТОК" />
                <NumericUpDown x:Name="EdSize" Minimum="1" Maximum="8" HorizontalAlignment="Stretch" ValueChanged="OnSizeChanged" />
              </StackPanel>

              <TextBlock Classes="lbl" Text="ЦВЕТ" />
              <WrapPanel x:Name="ColorHost" Orientation="Horizontal" Margin="0,0,0,8" />

              <CheckBox x:Name="CbAura" Content="Аура" Foreground="{DynamicResource C_efe3d2}" IsCheckedChanged="OnAuraChanged" />
              <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,6">
                <TextBlock Classes="lbl" Text="РАДИУС АУРЫ, ФТ" VerticalAlignment="Center" />
                <NumericUpDown x:Name="EdAuraFt" Grid.Column="1" Minimum="5" Maximum="200" Width="110" ValueChanged="OnAuraFtChanged" />
              </Grid>

              <CheckBox x:Name="CbLight" Content="Свет" Foreground="{DynamicResource C_efe3d2}" IsCheckedChanged="OnLightChanged" />
              <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,6">
                <TextBlock Classes="lbl" Text="РАДИУС СВЕТА, ФТ" VerticalAlignment="Center" />
                <NumericUpDown x:Name="EdLightFt" Grid.Column="1" Minimum="5" Maximum="200" Width="110" ValueChanged="OnLightFtChanged" />
              </Grid>

              <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,6">
                <TextBlock Classes="lbl" Text="НОЧНОЕ ЗРЕНИЕ, ФТ" VerticalAlignment="Center" />
                <NumericUpDown x:Name="EdVisionFt" Grid.Column="1" Minimum="0" Maximum="300" Width="110" ValueChanged="OnVisionFtChanged" />
              </Grid>

              <CheckBox x:Name="CbHidden" Content="Скрыт от игроков" Foreground="{DynamicResource C_efe3d2}" IsCheckedChanged="OnHiddenChanged" Margin="0,0,0,6" />

              <ComboBox x:Name="EdType" Margin="0,4,0,8" SelectedIndex="2" SelectionChanged="OnTypeChanged">
                <ComboBoxItem Tag="player">Игрок</ComboBoxItem>
                <ComboBoxItem Tag="npc">НПС</ComboBoxItem>
                <ComboBoxItem Tag="mob">Моб</ComboBoxItem>
              </ComboBox>

              <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
                <Button Classes="tool" Content="+ Токен" Click="OnAddToken" />
                <Button Classes="tool" x:Name="BtnTokenImage" Content="Картинка…" Click="OnTokenImage" />
                <Button Classes="tool" Content="90°" Click="OnRotateToken" ToolTip.Tip="Повернуть картинку" />
                <Button Classes="tool" Content="⇄" Click="OnFlipTokenX" ToolTip.Tip="Отразить по горизонтали" />
                <Button Classes="tool" Content="⇅" Click="OnFlipTokenY" ToolTip.Tip="Отразить по вертикали" />
                <Button Classes="tool" Content="Удалить" Click="OnDeleteToken" />
              </WrapPanel>
              <Button x:Name="OpenBtn" Classes="goldbtn" Content="Открыть лист" Click="OnOpenSheet" Margin="0,8,0,0" HorizontalAlignment="Stretch" />

              <StackPanel x:Name="PropPanel" Spacing="6" Margin="0,16,0,0">
                <TextBlock Classes="sec" Text="Предмет" />
                <TextBlock x:Name="PropName" Foreground="{DynamicResource C_f6e7cf}" FontSize="13" FontWeight="SemiBold" Text="Выберите предмет на карте" TextWrapping="Wrap" />
                <CheckBox x:Name="CbPropAlways" Content="Виден всегда (даже вне зрения)" Foreground="{DynamicResource C_efe3d2}" IsEnabled="False" IsCheckedChanged="OnPropFlagsToggled" />
                <CheckBox x:Name="CbPropHidden" Content="Скрыт от игроков" Foreground="{DynamicResource C_efe3d2}" IsEnabled="False" IsCheckedChanged="OnPropFlagsToggled" />
                <Button Classes="tool" x:Name="BtnDeleteProp" Content="Удалить предмет" IsEnabled="False" Click="OnDeleteProp" />

              <StackPanel x:Name="TplPanel" Spacing="6" Margin="0,16,0,0">
                <TextBlock Classes="sec" Text="Шаблон" />
                <TextBlock x:Name="TplName" Foreground="{DynamicResource C_f6e7cf}" FontSize="13" FontWeight="SemiBold" Text="Выберите шаблон на карте" TextWrapping="Wrap" />
                <CheckBox x:Name="CbTplAlways" Content="Виден всегда (даже вне зрения)" Foreground="{DynamicResource C_efe3d2}" IsEnabled="False" IsCheckedChanged="OnTplFlagsToggled" />
                <CheckBox x:Name="CbTplHidden" Content="Скрыт от игроков" Foreground="{DynamicResource C_efe3d2}" IsEnabled="False" IsCheckedChanged="OnTplFlagsToggled" />
                <Button Classes="tool" x:Name="BtnDeleteTpl" Content="Удалить шаблон" IsEnabled="False" Click="OnDeleteTpl" />
              </StackPanel>
              </StackPanel>
            </StackPanel>

            <!-- КАРТА -->
            <StackPanel>
              <TextBlock Classes="sec" Text="Карта" />
              <Grid ColumnDefinitions="*,*" Margin="0,0,0,8">
                <StackPanel>
                  <TextBlock Classes="lbl" Text="КЛЕТКА НА КАРТИНКЕ, PX" />
                  <Grid ColumnDefinitions="*,Auto">
                    <Slider x:Name="SldGridPx" Minimum="16" Maximum="200" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnGridSliderChanged" VerticalAlignment="Center" />
                    <TextBlock x:Name="GridPxText" Grid.Column="1" Foreground="{DynamicResource C_f0c27b}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" Text="64" />
                  </Grid>
                  <Button Classes="tool" x:Name="BtnManualGrid" Content="Настроить вручную (мышью)" HorizontalAlignment="Stretch" Margin="0,6,0,0" Click="OnManualGrid" />
                  <Grid x:Name="GridAdjustActions" ColumnDefinitions="*,*" ColumnSpacing="6" IsVisible="False" Margin="0,4,0,0">
                    <Button Classes="tool" Content="Готово" Click="OnGridAdjustDone" Background="{DynamicResource C_cf9245}" Foreground="{DynamicResource C_241505}" />
                    <Button Grid.Column="1" Classes="tool" Content="Отмена" Click="OnGridAdjustCancel" />
                  </Grid>
                  <Button Classes="tool" Content="Числом…" HorizontalAlignment="Stretch" Margin="0,4,0,0" Click="OnManualGridDialog" />
                  <TextBlock Classes="lbl" Text="Меняет число клеток под фон, камера не двигается" FontSize="10" Opacity="0.8" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Classes="lbl" Text="ФУТОВ В КЛЕТКЕ" />
                  <NumericUpDown x:Name="EdFeet" Minimum="1" Maximum="30" Width="86" ValueChanged="OnFeetChanged" />
                </StackPanel>
              </Grid>

              <TextBlock Classes="lbl" Text="ТИП СЕТКИ" />
              <ComboBox x:Name="EdGridType" Margin="0,0,0,8" SelectedIndex="0" SelectionChanged="OnGridTypeChanged">
                <ComboBoxItem Tag="square">Квадратная</ComboBoxItem>
                <ComboBoxItem Tag="hex">Гексагональная</ComboBoxItem>
              </ComboBox>

              <CheckBox x:Name="CbGridVisible" Content="Показывать сетку" Foreground="{DynamicResource C_efe3d2}" IsCheckedChanged="OnGridVisibleChanged" />
              <CheckBox x:Name="CbSnap" Content="Привязка к клеткам" Foreground="{DynamicResource C_efe3d2}" IsCheckedChanged="OnSnapChanged" />
              <CheckBox x:Name="CbFog" Content="Туман войны" Foreground="{DynamicResource C_efe3d2}" IsCheckedChanged="OnFogChanged" />
              <TextBlock Classes="lbl" Text="СЛОИ" Margin="0,8,0,0" />
              <WrapPanel Orientation="Horizontal" ItemSpacing="10" LineSpacing="4">
                <CheckBox x:Name="CbLayerWalls" Content="Стены" Foreground="{DynamicResource C_efe3d2}" IsChecked="True" IsCheckedChanged="OnLayerToggled" />
                <CheckBox x:Name="CbLayerProps" Content="Пропсы" Foreground="{DynamicResource C_efe3d2}" IsChecked="True" IsCheckedChanged="OnLayerToggled" />
                <CheckBox x:Name="CbLayerTemplates" Content="Шаблоны" Foreground="{DynamicResource C_efe3d2}" IsChecked="True" IsCheckedChanged="OnLayerToggled" />
                <CheckBox x:Name="CbLayerTokens" Content="Токены" Foreground="{DynamicResource C_efe3d2}" IsChecked="True" IsCheckedChanged="OnLayerToggled" />
              </WrapPanel>

              <CheckBox x:Name="CbVisionMode" Content="Зрение токенов (свет / ночное зрение)" Foreground="{DynamicResource C_efe3d2}" IsCheckedChanged="OnVisionModeChanged" />

              <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Button Classes="tool" Content="Открыть всё" Click="OnRevealAll" Margin="0,0,6,0" />
                <Button Classes="tool" Content="Скрыть всё" Click="OnHideAll" />
              </WrapPanel>

              <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                <TextBlock Classes="lbl" Text="КИСТЬ ТУМАНА, КЛЕТОК" VerticalAlignment="Center" />
                <NumericUpDown x:Name="EdFogBrush" Grid.Column="1" Minimum="1" Maximum="6" Width="110" Value="1" ValueChanged="OnFogBrushChanged" />
              </Grid>

              <TextBlock Classes="lbl" Text="СДВИГ СЕТКИ (КЛЕТКИ)" Margin="0,8,0,0" />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <StackPanel>
                  <TextBlock Classes="lbl" Text="ПО X" />
                  <NumericUpDown x:Name="EdGridOffX" Minimum="-3" Maximum="3" Increment="0.05" FormatString="0.00" HorizontalAlignment="Stretch" ValueChanged="OnGridOffX" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Classes="lbl" Text="ПО Y" />
                  <NumericUpDown x:Name="EdGridOffY" Minimum="-3" Maximum="3" Increment="0.05" FormatString="0.00" HorizontalAlignment="Stretch" ValueChanged="OnGridOffY" />

              <Button Classes="tool" x:Name="BtnCalib" Content="Калибровать сетку (2 клика)" Margin="0,8,0,0" HorizontalAlignment="Stretch" Click="OnCalibrate" />
              <TextBlock x:Name="CalibHint" Foreground="{DynamicResource C_9c8b78}" FontSize="11" TextWrapping="Wrap" Text="Кликните два угла одной клетки на фоне" IsVisible="False" />
                </StackPanel>
              </Grid>

              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
                <Button Classes="tool" Content="Очистить стены" Click="OnClearWalls" />
                <Button Classes="tool" Content="Отменить стену" Click="OnUndoWall" />
                <Button Classes="tool" Content="Очистить шаблоны" Click="OnClearTemplates" />
              </StackPanel>
            </StackPanel>

            <!-- СПИСОК ТОКЕНОВ -->
            <StackPanel>
              <TextBlock Classes="sec" Text="Токены на карте" />
              <ListBox x:Name="TokenList" SelectionChanged="OnTokenSelect" Background="Transparent" BorderThickness="0" MinHeight="120" />
            </StackPanel>

          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</UserControl>
